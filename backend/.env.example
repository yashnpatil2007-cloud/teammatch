PORT=5000
NODE_ENV=development

# Database Configuration
# In production, set USE_MONGO=true and provide a valid MongoDB Atlas connection URI
USE_MONGO=false
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/teammatch?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRE=7d

# Allowed Frontend Origins (comma-separated in production)
FRONTEND_URL=http://localhost:5173,https://teammatch-app.netlify.app,https://teammatch.netlify.app

# Optional Cloud File Storage (AWS S3 or Cloudinary)
# Prevents reliance on Render's ephemeral filesystem for permanent production files
# S3_BUCKET=your-teammatch-bucket
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
